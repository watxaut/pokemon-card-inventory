# Copy this file to .env and fill in what you need.

# Required for card recognition (camera -> card). Get one at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used to read the cards. Opus is the most accurate at reading small
# Japanese text; claude-haiku-5-5 is much cheaper if you scan a lot.
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (how hard the model thinks before answering)
CLAUDE_EFFORT=medium

# Optional: protect the app with a password (recommended before sharing a public link).
# Browsers will show a login prompt; any username works, the password must match.
APP_PASSWORD=

# Where the database and your photos are stored.
DATA_DIR=./data

# Card catalogue (official images + Cardmarket prices). Japanese by default.
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
CARD_LANGUAGE=ja
