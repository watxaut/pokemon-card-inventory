# Copy this file to .env and change what you need. Everything has a sensible default.

# Optional: protect the app with a password (recommended before sharing it).
# Browsers will show a login prompt; any username works, the password must match.
APP_PASSWORD=

# Where the database and your photos are stored.
DATA_DIR=./data

# Card catalogue (names, official images and Cardmarket prices).
# CARD_LANGUAGE is tried first when a card doesn't print its language: ja or en.
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
CARD_LANGUAGE=ja

# Only if Tesseract is installed somewhere unusual (e.g. on Windows):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
